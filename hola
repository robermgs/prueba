import pandas as pd
from pathlib import Path
import sys


# ============================================================
# CONFIGURACIÓN
# ============================================================

ARCHIVO_CTIO = "CTIO.csv"
ARCHIVO_CRITICAS = "criticas.csv"
ARCHIVO_SALIDA = "tarea_hecha.csv"

COLUMNA_NETBIOS = "Netbios Name"


# ============================================================
# FUNCIONES
# ============================================================

def leer_csv(ruta):
    """
    Intenta leer el CSV con las codificaciones más habituales
    en ficheros exportados desde Windows/Excel.
    """

    codificaciones = [
        "utf-8-sig",
        "cp1252",
        "latin1"
    ]

    for encoding in codificaciones:
        try:
            df = pd.read_csv(
                ruta,
                encoding=encoding,
                sep=None,
                engine="python",
                dtype=str
            )

            print(f"Leído: {ruta.name} ({encoding})")
            return df

        except (UnicodeDecodeError, pd.errors.ParserError):
            continue

    raise Exception(
        f"No se ha podido leer el archivo: {ruta.name}"
    )


def normalizar_netbios(valor):
    """
    Normaliza el NetBIOS para evitar problemas por:
    - espacios
    - mayúsculas/minúsculas
    """

    if pd.isna(valor):
        return ""

    return str(valor).strip().upper()


# ============================================================
# PROGRAMA PRINCIPAL
# ============================================================

def main():

    carpeta = Path(__file__).resolve().parent

    archivo_ctio = carpeta / ARCHIVO_CTIO
    archivo_criticas = carpeta / ARCHIVO_CRITICAS
    archivo_salida = carpeta / ARCHIVO_SALIDA

    # --------------------------------------------------------
    # Comprobar archivos
    # --------------------------------------------------------

    if not archivo_ctio.exists():
        print(f"ERROR: No existe {ARCHIVO_CTIO}")
        sys.exit(1)

    if not archivo_criticas.exists():
        print(f"ERROR: No existe {ARCHIVO_CRITICAS}")
        sys.exit(1)

    print()
    print("==============================================")
    print(" COMPARADOR CTIO vs CRITICAS")
    print("==============================================")
    print()

    # --------------------------------------------------------
    # Leer archivos
    # --------------------------------------------------------

    ctio = leer_csv(archivo_ctio)
    criticas = leer_csv(archivo_criticas)

    # --------------------------------------------------------
    # Comprobar columna NetBIOS
    # --------------------------------------------------------

    if COLUMNA_NETBIOS not in ctio.columns:
        print(
            f"ERROR: {ARCHIVO_CTIO} no contiene "
            f"la columna '{COLUMNA_NETBIOS}'."
        )
        print("Columnas encontradas:")
        print(list(ctio.columns))
        sys.exit(1)

    if COLUMNA_NETBIOS not in criticas.columns:
        print(
            f"ERROR: {ARCHIVO_CRITICAS} no contiene "
            f"la columna '{COLUMNA_NETBIOS}'."
        )
        print("Columnas encontradas:")
        print(list(criticas.columns))
        sys.exit(1)

    # --------------------------------------------------------
    # Normalizar NetBIOS
    # --------------------------------------------------------

    ctio["_NETBIOS_BUSQUEDA"] = (
        ctio[COLUMNA_NETBIOS]
        .apply(normalizar_netbios)
    )

    criticas["_NETBIOS_BUSQUEDA"] = (
        criticas[COLUMNA_NETBIOS]
        .apply(normalizar_netbios)
    )

    # Eliminar filas CTIO sin NetBIOS
    ctio = ctio[
        ctio["_NETBIOS_BUSQUEDA"] != ""
    ].copy()

    # --------------------------------------------------------
    # Lista única de equipos solicitados
    # --------------------------------------------------------

    equipos_ctio = (
        ctio["_NETBIOS_BUSQUEDA"]
        .drop_duplicates()
        .tolist()
    )

    print(f"Equipos recibidos de CTIO: {len(equipos_ctio)}")
    print(
        f"Registros en fichero de críticas: "
        f"{len(criticas)}"
    )

    # --------------------------------------------------------
    # Filtrar críticas
    # --------------------------------------------------------

    resultado = criticas[
        criticas["_NETBIOS_BUSQUEDA"].isin(equipos_ctio)
    ].copy()

    # --------------------------------------------------------
    # Saber qué equipos no aparecen
    # --------------------------------------------------------

    encontrados = set(
        resultado["_NETBIOS_BUSQUEDA"]
    )

    no_encontrados = [
        equipo
        for equipo in equipos_ctio
        if equipo not in encontrados
    ]

    # --------------------------------------------------------
    # Añadir estado de búsqueda
    # --------------------------------------------------------

    resultado["Resultado_Busqueda"] = "ENCONTRADO"

    # --------------------------------------------------------
    # Eliminar columna técnica
    # --------------------------------------------------------

    resultado.drop(
        columns=["_NETBIOS_BUSQUEDA"],
        inplace=True
    )

    # --------------------------------------------------------
    # Guardar resultado
    # --------------------------------------------------------

    resultado.to_csv(
        archivo_salida,
        index=False,
        encoding="utf-8-sig"
    )

    # --------------------------------------------------------
    # Crear también listado de no encontrados
    # --------------------------------------------------------

    archivo_no_encontrados = (
        carpeta / "equipos_no_encontrados.csv"
    )

    if no_encontrados:

        df_no_encontrados = pd.DataFrame({
            "Netbios Name": no_encontrados,
            "Resultado_Busqueda": "NO ENCONTRADO"
        })

        df_no_encontrados.to_csv(
            archivo_no_encontrados,
            index=False,
            encoding="utf-8-sig"
        )

    # --------------------------------------------------------
    # Resumen
    # --------------------------------------------------------

    print()
    print("==============================================")
    print(" RESULTADO")
    print("==============================================")
    print()
    print(f"Equipos de CTIO:       {len(equipos_ctio)}")
    print(f"Encontrados:           {len(encontrados)}")
    print(f"No encontrados:        {len(no_encontrados)}")
    print(f"Filas obtenidas:       {len(resultado)}")
    print()
    print(f"Resultado: {ARCHIVO_SALIDA}")

    if no_encontrados:
        print(
            f"No encontrados: "
            f"{archivo_no_encontrados.name}"
        )

    print()
    print("Proceso terminado.")


if __name__ == "__main__":
    main()
